{
  "name": "bondera-backend",
  "version": "1.0.0",
  "description": "Bondera real-time chat backend",
  "main": "dist/server.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "google-auth-library": "^11.0.2",
    "helmet": "^7.1.0",
    "jquery": "^4.0.0",
    "jquery-validation": "^1.22.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.5.4",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "openai": "^7.5.0",
    "redis": "^6.2.1",
    "socket.io": "^4.8.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.5.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
